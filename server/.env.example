DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/resource_booking?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=5000
CLIENT_URL="http://localhost:5173"

# SMTP email settings. Gmail example: use a Google App Password, not your normal password.
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=465
EMAIL_SECURE="true"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-16-character-app-password"
EMAIL_FROM="ResourceBook <your-email@gmail.com>"
